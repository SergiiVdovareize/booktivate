{
  "name": "reaktivate-tdd-challenge-1-sample-begin",
  "version": "1.0.0",
  "description": "How we create a fast-test architecture from scratch.",
  "homepage": ".",
  "keywords": [],
  "main": "src/index.js",
  "dependencies": {
    "mobx": "6.3.10",
    "mobx-react": "7.2.1",
    "react": "16.8.6",
    "react-dom": "16.8.6",
    "react-scripts": "3.0.1"
  },
  "devDependencies": {
    "@argos-ci/cli": "^6.9.0",
    "@argos-ci/playwright": "^7.4.6",
    "@biomejs/biome": "^2.5.10",
    "@playwright/test": "^1.62.1",
    "dotenv-cli": "^8.0.0",
    "typescript": "3.3.3"
  },
  "scripts": {
    "start": "NODE_OPTIONS=--openssl-legacy-provider react-scripts start",
    "build": "NODE_OPTIONS=--openssl-legacy-provider react-scripts build && mkdir -p build/coverage && cp -r coverage/lcov-report/* build/coverage/",
    "test": "NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom",
    "test:coverage": "NODE_OPTIONS=--openssl-legacy-provider react-scripts test --env=jsdom --coverage --watchAll=false",
    "test:argos": "npx playwright test && npx dotenv -- argos upload screenshots",
    "argos:upload": "npx dotenv -- argos upload screenshots",
    "lint": "npx @biomejs/biome check src",
    "lint:fix": "npx @biomejs/biome check --write src",
    "format": "npx @biomejs/biome format --write src",
    "eject": "react-scripts eject"
  },
  "jest": {
    "collectCoverageFrom": [
      "src/**/*.{js,jsx}",
      "!src/index.js"
    ]
  },
  "browserslist": [
    ">0.2%",
    "not dead",
    "not ie <= 11",
    "not op_mini all"
  ]
}
